pipeline {
    agent any
    
    environment {
        APP_NAME = 'kea-business-intelligence'
        ENVIRONMENT = 'homologation'
        CONTAINER_NAME = 'kea-bi-homologation'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Stop Existing Container') {
            steps {
                sh '''
                    docker-compose -f docker/docker-compose.hml.yml down || true
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                '''
            }
        }
        
        stage('Build and Deploy') {
            steps {
                sh '''
                    # Build e deploy usando docker-compose
                    docker-compose -f docker/docker-compose.hml.yml up --build -d
                    
                    # Aguardar container iniciar
                    sleep 30
                    
                    # Verificar se está rodando
                    if docker ps | grep -q ${CONTAINER_NAME}; then
                        echo "✅ Container ${CONTAINER_NAME} rodando"
                    else
                        echo "❌ Container ${CONTAINER_NAME} não está rodando"
                        docker logs ${CONTAINER_NAME}
                        exit 1
                    fi
                '''
            }
        }
        
        stage('Health Check') {
            steps {
                sh '''
                    # Verificar saúde da aplicação
                    for i in {1..10}; do
                        if curl -f http://localhost:6001/api/test > /dev/null 2>&1; then
                            echo "✅ Aplicação respondendo na porta 6001"
                            break
                        else
                            echo "Tentativa $i/10 - Aguardando aplicação..."
                            sleep 10
                        fi
                    done
                    
                    # Verificação final
                    if curl -f http://localhost:6001/api/test > /dev/null 2>&1; then
                        SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
                        echo "🎉 HOMOLOGAÇÃO DEPLOY CONCLUÍDO!"
                        echo "🌐 Frontend: http://$SERVER_IP:6001/"
                        echo "🔌 API: http://$SERVER_IP:6001/api/test"
                        echo "🔐 Login: http://$SERVER_IP:6001/api/auth/login"
                    else
                        echo "❌ Aplicação não está respondendo"
                        docker logs ${CONTAINER_NAME}
                        exit 1
                    fi
                '''
            }
        }
    }
    
    post {
        success {
            echo '🎉 Deploy de homologação realizado com sucesso!'
        }
        failure {
            sh 'docker logs ${CONTAINER_NAME} || true'
            echo '❌ Deploy de homologação falhou!'
        }
    }
}