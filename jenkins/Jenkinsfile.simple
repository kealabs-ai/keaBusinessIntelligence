pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    # Executar script de deploy
                    chmod +x jenkins/deploy-environment.sh
                    ./jenkins/deploy-environment.sh all
                '''
            }
        }
    }
    
    post {
        success {
            echo '🎉 Deploy realizado com sucesso!'
        }
        failure {
            echo '❌ Deploy falhou!'
        }
    }
}