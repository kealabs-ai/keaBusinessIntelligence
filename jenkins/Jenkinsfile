pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'kea-business-intelligence'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}", "-f docker/Dockerfile .")
                }
            }
        }
        
        stage('Test') {
            steps {
                script {
                    docker.image("${DOCKER_IMAGE}:${DOCKER_TAG}").inside {
                        sh 'python -m pytest tests/ || true'
                    }
                }
            }
        }
        
        stage('Deploy to Development') {
            steps {
                script {
                    sh """
                        docker stop kea-bi-dev || true
                        docker rm kea-bi-dev || true
                        docker run -d --name kea-bi-dev -p 5001:5000 \
                            -e DB_SERVER=\${DEV_DB_SERVER} \
                            -e DB_NAME=\${DEV_DB_NAME} \
                            -e DB_USER=\${DEV_DB_USER} \
                            -e DB_PASSWORD=\${DEV_DB_PASSWORD} \
                            -e OPENAI_API_KEY=\${OPENAI_API_KEY} \
                            -e GEMINI_API_KEY=\${GEMINI_API_KEY} \
                            -e OLLAMA_BASE_URL=\${OLLAMA_BASE_URL} \
                            -e DEFAULT_LLM_PROVIDER=\${DEFAULT_LLM_PROVIDER} \
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                        echo "✅ Aplicação disponível em: http://localhost:5001"
                    """
                }
            }
        }
        
        stage('Deploy to Homologation') {
            when {
                branch 'hml'
            }
            steps {
                script {
                    sh """
                        docker stop kea-bi-hml || true
                        docker rm kea-bi-hml || true
                        docker run -d --name kea-bi-hml -p 5002:5000 \
                            -e DB_SERVER=\${HML_DB_SERVER} \
                            -e DB_NAME=\${HML_DB_NAME} \
                            -e DB_USER=\${HML_DB_USER} \
                            -e DB_PASSWORD=\${HML_DB_PASSWORD} \
                            -e OPENAI_API_KEY=\${OPENAI_API_KEY} \
                            -e GEMINI_API_KEY=\${GEMINI_API_KEY} \
                            -e OLLAMA_BASE_URL=\${OLLAMA_BASE_URL} \
                            -e DEFAULT_LLM_PROVIDER=\${DEFAULT_LLM_PROVIDER} \
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                        echo "✅ Aplicação disponível em: http://localhost:5002"
                    """
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    sh """
                        docker stop kea-bi-prod || true
                        docker rm kea-bi-prod || true
                        docker run -d --name kea-bi-prod -p 5000:5000 \
                            -e DB_SERVER=\${PROD_DB_SERVER} \
                            -e DB_NAME=\${PROD_DB_NAME} \
                            -e DB_USER=\${PROD_DB_USER} \
                            -e DB_PASSWORD=\${PROD_DB_PASSWORD} \
                            -e OPENAI_API_KEY=\${OPENAI_API_KEY} \
                            -e GEMINI_API_KEY=\${GEMINI_API_KEY} \
                            -e OLLAMA_BASE_URL=\${OLLAMA_BASE_URL} \
                            -e DEFAULT_LLM_PROVIDER=\${DEFAULT_LLM_PROVIDER} \
                            ${DOCKER_IMAGE}:${DOCKER_TAG}
                        echo "✅ Aplicação disponível em: http://localhost:5000"
                    """
                }
            }
        }
    }
    
    post {
        always {
            sh "docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true"
        }
    }
}