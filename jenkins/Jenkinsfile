pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        APP_NAME = 'kea-business-intelligence'
        BUILD_DIR = 'frontend/businessIntelligence/build'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Node.js') {
            steps {
                sh '''
                    curl -fsSL https://deb.nodesource.com/setup_18.x | sudo bash -
                    sudo apt-get install -y nodejs
                    node --version
                    npm --version
                '''
            }
        }
        
        stage('Build Frontend') {
            steps {
                dir('frontend/businessIntelligence') {
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }
        
        stage('Test Frontend') {
            steps {
                dir('frontend/businessIntelligence') {
                    sh 'npm test -- --coverage --watchAll=false || true'
                }
            }
        }
        
        stage('Deploy to Development') {
            steps {
                sh '''
                    # Parar serviços existentes
                    sudo systemctl stop kea-bi-dev || true
                    
                    # Copiar arquivos de build
                    sudo mkdir -p /var/www/kea-bi-dev
                    sudo cp -r frontend/businessIntelligence/build/* /var/www/kea-bi-dev/
                    
                    # Configurar nginx ou servir arquivos estáticos
                    sudo chown -R www-data:www-data /var/www/kea-bi-dev
                    
                    # Obter IP do servidor
                    SERVER_IP=$(curl -s ifconfig.me)
                    echo "✅ Frontend disponível em: http://$SERVER_IP/kea-bi-dev"
                    echo "✅ Build concluído com sucesso!"
                '''
            }
        }
        
        stage('Deploy to Homologation') {
            when {
                branch 'hml'
            }
            steps {
                sh '''
                    sudo mkdir -p /var/www/kea-bi-hml
                    sudo cp -r frontend/businessIntelligence/build/* /var/www/kea-bi-hml/
                    sudo chown -R www-data:www-data /var/www/kea-bi-hml
                    
                    SERVER_IP=$(curl -s ifconfig.me)
                    echo "✅ Homologação disponível em: http://$SERVER_IP/kea-bi-hml"
                '''
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                    sudo mkdir -p /var/www/kea-bi-prod
                    sudo cp -r frontend/businessIntelligence/build/* /var/www/kea-bi-prod/
                    sudo chown -R www-data:www-data /var/www/kea-bi-prod
                    
                    SERVER_IP=$(curl -s ifconfig.me)
                    echo "✅ Produção disponível em: http://$SERVER_IP/kea-bi-prod"
                '''
            }
        }
    }
    
    
    post {
        always {
            echo 'Pipeline concluído!'
        }
        success {
            echo 'Deploy realizado com sucesso!'
        }
        failure {
            echo 'Deploy falhou!'
        }
    }
}