pipeline {
    agent any
    
    environment {
        NODE_VERSION = '18'
        APP_NAME = 'kea-business-intelligence'
        BUILD_DIR = 'frontend/businessIntelligence/build'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Frontend') {
            steps {
                script {
                    docker.image('node:18-alpine').inside() {
                        dir('frontend/businessIntelligence') {
                            sh 'npm install'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }
        
        stage('Build Docker') {
            steps {
                script {
                    def buildNumber = env.BUILD_NUMBER
                    sh "docker build -t kea-business-intelligence:${buildNumber} -f docker/Dockerfile ."
                }
            }
        }
        
        stage('Test Frontend') {
            steps {
                script {
                    docker.image('node:18-alpine').inside() {
                        dir('frontend/businessIntelligence') {
                            sh 'npm test -- --coverage --watchAll=false || true'
                        }
                    }
                }
            }
        }
        
        stage('Test Backend') {
            steps {
                script {
                    def buildNumber = env.BUILD_NUMBER
                    docker.image("kea-business-intelligence:${buildNumber}").inside() {
                        sh 'python -m pytest tests/ || true'
                    }
                }
            }
        }
        
        stage('Deploy to Development') {
            steps {
                script {
                    def buildNumber = env.BUILD_NUMBER
                    sh '''
                        docker stop kea-bi-dev || true
                        docker rm kea-bi-dev || true
                        docker run -d --name kea-bi-dev -p 5001:5000 \
                            -e DB_SERVER= \
                            -e DB_NAME= \
                            -e DB_USER= \
                            -e DB_PASSWORD= \
                            -e OPENAI_API_KEY= \
                            -e GEMINI_API_KEY= \
                            -e OLLAMA_BASE_URL= \
                            -e DEFAULT_LLM_PROVIDER= \
                            kea-business-intelligence:''' + buildNumber + '''
                        
                        SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
                        echo "✅ Aplicação disponível em: http://$SERVER_IP:5001"
                        echo "✅ Endpoint de teste: http://$SERVER_IP:5001/api/test"
                    '''
                }
            }
        }
        
        stage('Deploy to Homologation') {
            when {
                branch 'hml'
            }
            steps {
                script {
                    def buildNumber = env.BUILD_NUMBER
                    sh '''
                        docker stop kea-bi-hml || true
                        docker rm kea-bi-hml || true
                        docker run -d --name kea-bi-hml -p 5002:5000 \
                            -e DB_SERVER= \
                            -e DB_NAME= \
                            -e DB_USER= \
                            -e DB_PASSWORD= \
                            -e OPENAI_API_KEY= \
                            -e GEMINI_API_KEY= \
                            -e OLLAMA_BASE_URL= \
                            -e DEFAULT_LLM_PROVIDER= \
                            kea-business-intelligence:''' + buildNumber + '''
                        
                        SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
                        echo "✅ Homologação disponível em: http://$SERVER_IP:5002"
                    '''
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    def buildNumber = env.BUILD_NUMBER
                    sh '''
                        docker stop kea-bi-prod || true
                        docker rm kea-bi-prod || true
                        docker run -d --name kea-bi-prod -p 5000:5000 \
                            -e DB_SERVER= \
                            -e DB_NAME= \
                            -e DB_USER= \
                            -e DB_PASSWORD= \
                            -e OPENAI_API_KEY= \
                            -e GEMINI_API_KEY= \
                            -e OLLAMA_BASE_URL= \
                            -e DEFAULT_LLM_PROVIDER= \
                            kea-business-intelligence:''' + buildNumber + '''
                        
                        SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
                        echo "✅ Produção disponível em: http://$SERVER_IP:5000"
                    '''
                }
            }
        }
    }
    
    
    post {
        always {
            script {
                def buildNumber = env.BUILD_NUMBER
                sh "docker rmi kea-business-intelligence:${buildNumber} || true"
            }
            echo 'Pipeline concluído!'
        }
        success {
            echo 'Deploy realizado com sucesso!'
        }
        failure {
            echo 'Deploy falhou!'
        }
    }
}