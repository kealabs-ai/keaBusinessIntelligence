pipeline {
    agent any
    
    environment {
        APP_NAME = 'kea-business-intelligence'
        ENVIRONMENT = 'production'
        PORT = '6000'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Frontend') {
            steps {
                dir('frontend/businessIntelligence') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }
        
        stage('Deploy Production') {
            steps {
                sh '''
                    PROD_PATH="/var/jenkins_home/workspace/deploy/kea-bi-prod"
                    mkdir -p $PROD_PATH
                    
                    # Copiar todos os arquivos
                    cp -r . $PROD_PATH/
                    
                    # Parar serviço existente
                    pkill -f "python.*start_prod.py" || true
                    sleep 5
                    
                    # Instalar dependências
                    cd $PROD_PATH
                    python3 -m pip install -r requirements.txt
                    
                    # Iniciar serviço de produção
                    export PYTHONPATH=$PROD_PATH:$PYTHONPATH
                    nohup python3 start_prod.py > /var/jenkins_home/workspace/deploy/prod.log 2>&1 &
                    
                    sleep 10
                    
                    # Verificar se está rodando
                    SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
                    
                    if curl -f http://localhost:6000/api/test > /dev/null 2>&1; then
                        echo "✅ Produção iniciada com sucesso!"
                        echo "🌐 Frontend: http://$SERVER_IP:6000/"
                        echo "🔌 API: http://$SERVER_IP:6000/api/test"
                        echo "🔐 Login: http://$SERVER_IP:6000/api/auth/login"
                    else
                        echo "❌ Erro ao iniciar produção"
                        tail -20 /var/jenkins_home/workspace/deploy/prod.log
                        exit 1
                    fi
                '''
            }
        }
    }
    
    post {
        success {
            echo '🎉 Deploy de produção realizado com sucesso!'
        }
        failure {
            echo '❌ Deploy de produção falhou!'
        }
    }
}