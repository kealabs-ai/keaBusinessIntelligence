pipeline {
    agent any
    
    stages {
        stage('Setup') {
            steps {
                sh '''
                    # Instalar Docker se necessário
                    if ! command -v docker &> /dev/null; then
                        curl -fsSL https://get.docker.com | sh
                        usermod -aG docker jenkins || true
                    fi
                    
                    # Parar containers existentes
                    docker stop kea-bi-production kea-bi-homologation kea-bi-development || true
                    docker rm kea-bi-production kea-bi-homologation kea-bi-development || true
                '''
            }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    # Build e deploy usando Docker diretamente
                    cd docker
                    
                    # Produção
                    docker build -t kea-bi:prod -f Dockerfile ..
                    docker run -d --name kea-bi-production -p 6000:6000 --env-file ../.env.prod -e SERVER_PORT=6000 -e ENVIRONMENT=production kea-bi:prod
                    
                    # Homologação  
                    docker run -d --name kea-bi-homologation -p 6001:6001 --env-file ../.env.hml -e SERVER_PORT=6001 -e ENVIRONMENT=homologation kea-bi:prod
                    
                    # Desenvolvimento
                    docker run -d --name kea-bi-development -p 6002:6002 --env-file ../.env.dev -e SERVER_PORT=6002 -e ENVIRONMENT=development kea-bi:prod
                    
                    # Aguardar inicialização
                    sleep 30
                    
                    # Verificar saúde
                    echo "🔴 Produção: $(curl -s http://localhost:6000/api/test || echo 'ERRO')"
                    echo "🟡 Homologação: $(curl -s http://localhost:6001/api/test || echo 'ERRO')" 
                    echo "🟢 Desenvolvimento: $(curl -s http://localhost:6002/api/test || echo 'ERRO')"
                    
                    # URLs de acesso
                    SERVER_IP=$(curl -s ifconfig.me || echo "localhost")
                    echo "🌐 Produção: http://$SERVER_IP:6000/"
                    echo "🌐 Homologação: http://$SERVER_IP:6001/"
                    echo "🌐 Desenvolvimento: http://$SERVER_IP:6002/"
                '''
            }
        }
    }
}